+/// Piecewise-linear interpolation over `n` sorted points, clamped at the ends.
+fn interp(n: usize, x: impl Fn(usize) -> f64, y: impl Fn(usize) -> f64, at: f64) -> f64 {
+    if at <= x(0) {
+        return y(0);
+    }
+    for i in 1..n {
+        if at <= x(i) {
+            let t = (at - x(i - 1)) / (x(i) - x(i - 1));
+            return y(i - 1) + t * (y(i) - y(i - 1));
+        }
+    }
+    y(n - 1)
+}
